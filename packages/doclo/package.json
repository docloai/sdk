{
  "name": "@doclo/sdk",
  "version": "0.1.0",
  "description": "Doclo SDK - Document extraction, parsing, and processing with AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/docloai/sdk.git",
    "directory": "packages/doclo"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@doclo/core": "workspace:^",
    "@doclo/nodes": "workspace:^",
    "@doclo/flows": "workspace:^",
    "@doclo/providers-llm": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "doclo",
    "document",
    "extraction",
    "ocr",
    "llm",
    "vlm",
    "ai",
    "sdk",
    "parsing",
    "pdf"
  ],
  "engines": {
    "node": ">=18"
  }
}
