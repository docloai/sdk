{
  "name": "@doclo/otel",
  "version": "0.1.0",
  "description": "OpenTelemetry instrumentation for the Doclo SDK - traces and metrics export",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/docloai/sdk.git",
    "directory": "packages/otel"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@doclo/core": "^0.1.8"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": false
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
